# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/
/dist/
/.runtime-build/
/.local/chatgpt-web-reference/
/node_modules/
/.wrangler/

# 正解表（tests/oracle.py で作り直せる。数 MB あるので置かない）
tests/oracle.*.json.gz
tests/current.json

# Large real-app fixtures are fetched on demand with tools/fetch-large-fixtures.mjs.
/tests/battlecats
/tests/TsumTsum
/tests/YWP

# 画面の写し（KEEP=1 npm run browser で作り直せる）
tests/.shots/

# ローカルの配布用アーカイブ・誤作成されたrootファイルはrepoへ戻さない
/hex.zip
/a

# 実アプリの大容量fixtureはopt-inで取得し、Gitには戻さない
tests/.real-fixtures/

# Phase 6 verifier output. It binds a verdict to an exact commit and tree, so
# committing it would make every verification run dirty the tree it just
# verified. CI publishes it as a build artifact instead.
/reports/phase6/phase6-release-evidence.json
/reports/phase6/phase6-release-evidence.md
/reports/stage1/
/reports/stage2/
/reports/competitive/

