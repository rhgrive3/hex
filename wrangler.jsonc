{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ida",
  "main": "./worker-entry.js",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_QUOTA",
        "class_name": "AIQuota"
      }
    ]
  },
  "exports": {
    "AIQuota": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
