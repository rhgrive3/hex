{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ida",
  "main": "./worker-entry.js",
  "compatibility_date": "2026-08-14",
  "build": {
    "command": "npm run userscript:build && node scripts/write-deployment-identity.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_QUOTA",
        "class_name": "AIQuota"
      },
      {
        "name": "RUNTIME_BOOTSTRAP",
        "class_name": "RuntimeBootstrap"
      }
    ]
  },
  "exports": {
    "AIQuota": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "RuntimeBootstrap": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
