{
  "name": "hex",
  "private": true,
  "type": "module",
  "description": "アプリの中身（Mach-O / ARM64）を日本語で読むためのビューア。ビルドはしない — index.html をそのまま開く静的サイト。",
  "scripts": {
    "lint": "node tests/check.mjs",
    "check": "npm run lint && npm test",
    "test": "node tests/run.js && node tests/ir.mjs && node tests/cfg-structuring.mjs && node tests/ux.mjs && node tests/gemini.mjs && node tests/words.mjs && node tests/api.mjs",
    "browser": "node tests/browser.mjs",
    "sandbox": "node tests/sandbox.mjs",
    "tools": "node tests/tools.mjs",
    "accuracy": "node --max-old-space-size=8000 tests/accuracy.mjs",
    "oracle": "python3 tests/oracle.py tests/battlecats tests/oracle.battlecats.json.gz",
    "binary:test": "node tests/universal-binary.mjs && node tests/universal-binary-sectionless.mjs",
    "binary:gate": "node tests/universal-binary-gate.mjs",
    "binary:benchmark": "node tests/universal-binary-benchmark.mjs"
  }
}
