{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "phase7-release-evidence/v1",
  "type": "object",
  "required": [
    "schemaVersion", "verifierId", "verifierVersion", "generatedAt", "product",
    "profileVersion", "corpus", "checkpoints", "alias", "memoryLinks", "types",
    "discovery", "debug", "architectureLanes", "performance", "failures", "verdict"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": "phase7-release-evidence/v1" },
    "verifierId": { "type": "string", "minLength": 1 },
    "verifierVersion": { "type": "string", "minLength": 1 },
    "product": {
      "type": "object",
      "required": ["commitSha", "treeSha", "workingTreeClean", "branch"],
      "properties": {
        "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "treeSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "workingTreeClean": { "type": "boolean" },
        "branch": { "type": "string" }
      }
    },
    "corpus": {
      "type": "object",
      "required": ["corpusId", "corpusVersion", "manifestDigest", "frozenDigestMatches", "scoring", "truthGenerator"]
    },
    "alias": {
      "type": "object",
      "required": ["baseline", "candidate", "falseNoAlias", "falseMustAlias"]
    },
    "memoryLinks": {
      "type": "object",
      "required": ["baseline", "candidate", "barrierBypasses"]
    },
    "failures": { "type": "array" },
    "verdict": { "enum": ["READY", "BLOCKING", "NOT-INTEGRATED"] }
  }
}
