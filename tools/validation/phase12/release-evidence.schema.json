{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hex.local/schemas/phase12-release-evidence-v1.json",
  "title": "phase12-release-evidence/v1",
  "type": "object",
  "required": ["schemaVersion", "phase", "verdict", "verifier", "product", "foundation", "gates", "evidenceDigest"],
  "properties": {
    "schemaVersion": { "const": "phase12-release-evidence/v1" },
    "phase": { "const": 12 },
    "verdict": { "enum": ["BLOCKING", "IN_PROGRESS", "READY"] },
    "verifier": {
      "type": "object",
      "required": ["id", "version"],
      "properties": { "id": { "const": "phase12.verifier" }, "version": { "type": "string" } }
    },
    "product": {
      "type": "object",
      "required": ["commitSha", "treeSha", "clean"],
      "properties": {
        "commitSha": { "pattern": "^[0-9a-f]{40}$" },
        "treeSha": { "pattern": "^[0-9a-f]{40}$" },
        "clean": { "type": "boolean" },
        "dirtyFiles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "foundation": { "type": "object", "required": ["commitSha", "treeSha"] },
    "gates": { "type": "array", "items": { "type": "object", "required": ["id", "status"] } },
    "evidenceDigest": { "pattern": "^[0-9a-f]{64}$" }
  }
}
