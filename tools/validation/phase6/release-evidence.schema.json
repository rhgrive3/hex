{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hex/phase6/release-evidence/v1",
  "title": "Phase 6 release evidence",
  "description": "Machine-readable verdict for one exact product head. Absence of a field is BLOCKING; a report that cannot be validated against this schema is not evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "verifierVersion", "verdict", "product", "identities", "counts", "gates", "failures", "generatedAt"],
  "properties": {
    "schemaVersion": { "const": "phase6-release-evidence/v1" },
    "verifierVersion": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["READY", "BLOCKING", "NOT-INTEGRATED"] },
    "generatedAt": { "type": "string", "minLength": 1 },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitSha", "treeSha", "workingTreeClean", "branch"],
      "properties": {
        "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "treeSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "workingTreeClean": { "type": "boolean" },
        "branch": { "type": "string" }
      }
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileVersion", "isaProfile", "abiProfiles", "toolchain", "decoderArtifacts", "architectureSemanticVersion", "abiSemanticVersion", "corpusId", "corpusDigest"],
      "properties": {
        "profileVersion": { "type": "string", "minLength": 1 },
        "isaProfile": { "type": "string", "minLength": 1 },
        "abiProfiles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "toolchain": { "type": "object" },
        "decoderArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "matchesFrozenProfile"],
            "properties": {
              "path": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "matchesFrozenProfile": { "type": "boolean" }
            }
          }
        },
        "architectureSemanticVersion": { "type": "string", "minLength": 1 },
        "abiSemanticVersion": { "type": "string", "minLength": 1 },
        "corpusId": { "type": "string", "minLength": 1 },
        "corpusDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mandatoryCorpusCases", "instantiatedCases", "missingCases",
        "exactEffects", "partialEffects", "unsupportedEffects",
        "semanticMismatches", "decoderMismatches", "abiMismatches", "elfMismatches",
        "provenanceLosses", "hiddenFallbacks",
        "unknownStoreSafetyFailures", "unknownCallSafetyFailures",
        "architectureNeutralityViolations", "staleArtifactFailures",
        "crossArchitectureMismatches", "firstDivergenceCount"
      ],
      "patternProperties": { "^.*$": { "type": "integer", "minimum": 0 } }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "detail"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL", "NOT-RUN"] },
          "detail": { "type": "string" }
        }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "firstDivergence", "expected", "actual", "identity", "blocking"],
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "firstDivergence": { "type": "string", "minLength": 1 },
          "expected": { "type": "string" },
          "actual": { "type": "string" },
          "identity": { "type": "string" },
          "blocking": { "type": "boolean" }
        }
      }
    }
  }
}
